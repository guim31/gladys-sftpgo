{
  "manifest_version": 1,
  "type": "device",
  "name": "SFTPGo",
  "description": {
    "en": "Your SFTPGo file server in Gladys: connections, quotas, and a scene when a file is uploaded.",
    "fr": "Votre serveur de fichiers SFTPGo dans Gladys : connexions, quotas, et une scène à chaque dépôt.",
    "de": "Dein SFTPGo-Dateiserver in Gladys: Verbindungen, Kontingente und eine Szene bei jedem Upload.",
    "es": "Su servidor de archivos SFTPGo en Gladys: conexiones, cuotas y una escena en cada subida."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/guim31/gladys-sftpgo:1.0.0",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-sftpgo/main/cover.png",
  "categories": ["services", "network"],
  "transports": ["local"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Your SFTPGo server",
        "fr": "Votre serveur SFTPGo",
        "de": "Dein SFTPGo-Server",
        "es": "Su servidor SFTPGo"
      },
      "description": {
        "en": "Enter the address of the SFTPGo web interface and an admin API key, or the username and password of an admin with the view_users, view_conns and view_events permissions. Then add the server and the users to follow from the Discover tab.",
        "fr": "Saisissez l'adresse de l'interface web de SFTPGo et une clé d'API d'admin, ou l'identifiant et le mot de passe d'un admin ayant les permissions view_users, view_conns et view_events. Ajoutez ensuite le serveur et les utilisateurs à suivre depuis l'onglet Découverte.",
        "de": "Gib die Adresse der SFTPGo-Weboberfläche und einen Admin-API-Schlüssel ein, oder Benutzername und Passwort eines Admins mit den Berechtigungen view_users, view_conns und view_events. Lege dann Server und Benutzer im Tab „Entdecken“ an.",
        "es": "Introduzca la dirección de la interfaz web de SFTPGo y una clave de API de administrador, o el usuario y la contraseña de un administrador con los permisos view_users, view_conns y view_events. Después añada el servidor y los usuarios desde la pestaña Descubrir."
      },
      "links": [
        {
          "url": "https://github.com/guim31/gladys-sftpgo/blob/main/docs/en.md",
          "label": {
            "en": "Setup guide",
            "fr": "Guide d'installation",
            "de": "Einrichtungsanleitung",
            "es": "Guía de instalación"
          }
        },
        {
          "url": "https://docs.sftpgo.com/latest/rest-api/",
          "label": {
            "en": "SFTPGo REST API",
            "fr": "API REST de SFTPGo",
            "de": "SFTPGo-REST-API",
            "es": "API REST de SFTPGo"
          }
        }
      ]
    },
    {
      "key": "url",
      "type": "string",
      "label": {
        "en": "SFTPGo address",
        "fr": "Adresse de SFTPGo",
        "de": "SFTPGo-Adresse",
        "es": "Dirección de SFTPGo"
      },
      "description": {
        "en": "The address of the web interface, port 8080 by default.",
        "fr": "L'adresse de l'interface web, port 8080 par défaut.",
        "de": "Die Adresse der Weboberfläche, standardmäßig Port 8080.",
        "es": "La dirección de la interfaz web, puerto 8080 por defecto."
      },
      "placeholder": {
        "en": "e.g. http://192.168.1.2:8080",
        "fr": "ex. http://192.168.1.2:8080",
        "de": "z. B. http://192.168.1.2:8080",
        "es": "p. ej. http://192.168.1.2:8080"
      },
      "required": true
    },
    {
      "key": "api_key",
      "type": "secret",
      "label": {
        "en": "Admin API key",
        "fr": "Clé d'API d'admin",
        "de": "Admin-API-Schlüssel",
        "es": "Clave de API de administrador"
      },
      "description": {
        "en": "Optional: an API key of an admin allowed to use it. Otherwise fill in the two fields below.",
        "fr": "Facultatif : une clé d'API d'un admin autorisé à s'en servir. Sinon, remplissez les deux champs suivants.",
        "de": "Optional: ein API-Schlüssel eines Admins, der ihn nutzen darf. Sonst fülle die zwei Felder darunter aus.",
        "es": "Opcional: una clave de API de un administrador autorizado a usarla. Si no, rellene los dos campos siguientes."
      },
      "required": false
    },
    {
      "key": "username",
      "type": "string",
      "label": {
        "en": "Admin username",
        "fr": "Identifiant de l'admin",
        "de": "Admin-Benutzername",
        "es": "Usuario administrador"
      },
      "description": {
        "en": "An SFTPGo admin, not a user of the file server.",
        "fr": "Un admin de SFTPGo, pas un utilisateur du serveur de fichiers.",
        "de": "Ein SFTPGo-Admin, kein Benutzer des Dateiservers.",
        "es": "Un administrador de SFTPGo, no un usuario del servidor de archivos."
      },
      "required": false
    },
    {
      "key": "password",
      "type": "secret",
      "label": {
        "en": "Admin password",
        "fr": "Mot de passe de l'admin",
        "de": "Admin-Passwort",
        "es": "Contraseña del administrador"
      },
      "required": false
    },
    {
      "key": "events",
      "type": "section",
      "label": {
        "en": "Uploads and failed logins",
        "fr": "Dépôts et connexions refusées",
        "de": "Uploads und abgelehnte Anmeldungen",
        "es": "Subidas e inicios de sesión rechazados"
      },
      "description": {
        "en": "They come from the event log of SFTPGo: its eventstore and eventsearch plugins (image drakkan/sftpgo:plugins, with PostgreSQL or MySQL). Without them, the rest works.",
        "fr": "Ils viennent du journal d'événements de SFTPGo : ses plugins eventstore et eventsearch (image drakkan/sftpgo:plugins, avec PostgreSQL ou MySQL). Sans eux, le reste fonctionne.",
        "de": "Dafür braucht es das Ereignisprotokoll von SFTPGo: seine Plugins eventstore und eventsearch (Image drakkan/sftpgo:plugins, mit PostgreSQL oder MySQL). Ohne diese Plugins funktioniert der Rest.",
        "es": "Provienen del registro de eventos de SFTPGo: sus plugins eventstore y eventsearch (imagen drakkan/sftpgo:plugins, con PostgreSQL o MySQL). Sin ellos, el resto funciona."
      },
      "links": [
        {
          "url": "https://docs.sftpgo.com/latest/plugins/",
          "label": {
            "en": "SFTPGo plugins",
            "fr": "Plugins de SFTPGo",
            "de": "SFTPGo-Plugins",
            "es": "Plugins de SFTPGo"
          }
        }
      ]
    },
    {
      "key": "poll_interval",
      "type": "select",
      "label": {
        "en": "Refresh interval",
        "fr": "Fréquence de lecture",
        "de": "Aktualisierungsintervall",
        "es": "Intervalo de actualización"
      },
      "description": {
        "en": "Also the delay of the scene on a file uploaded.",
        "fr": "C'est aussi le délai de la scène sur un fichier déposé.",
        "de": "Auch die Verzögerung der Szene bei einer hochgeladenen Datei.",
        "es": "También el retraso de la escena ante un archivo subido."
      },
      "options": [
        {
          "value": "10",
          "label": {
            "en": "10 seconds",
            "fr": "10 secondes",
            "de": "10 Sekunden",
            "es": "10 segundos"
          }
        },
        {
          "value": "30",
          "label": {
            "en": "30 seconds",
            "fr": "30 secondes",
            "de": "30 Sekunden",
            "es": "30 segundos"
          }
        },
        {
          "value": "60",
          "label": {
            "en": "1 minute",
            "fr": "1 minute",
            "de": "1 Minute",
            "es": "1 minuto"
          }
        },
        {
          "value": "300",
          "label": {
            "en": "5 minutes",
            "fr": "5 minutes",
            "de": "5 Minuten",
            "es": "5 minutos"
          }
        }
      ],
      "default": "30"
    },
    {
      "key": "quota_threshold",
      "type": "select",
      "label": {
        "en": "Quota alert threshold",
        "fr": "Seuil d'alerte de quota",
        "de": "Kontingent-Warnschwelle",
        "es": "Umbral de alerta de cuota"
      },
      "description": {
        "en": "The scene trigger fires when a user goes above it.",
        "fr": "Le déclencheur de scène part quand un utilisateur le dépasse.",
        "de": "Der Szenen-Auslöser startet, wenn ein Benutzer sie überschreitet.",
        "es": "El disparador de escena se activa cuando un usuario lo supera."
      },
      "options": [
        {
          "value": "70",
          "label": {
            "en": "70 %",
            "fr": "70 %",
            "de": "70 %",
            "es": "70 %"
          }
        },
        {
          "value": "80",
          "label": {
            "en": "80 %",
            "fr": "80 %",
            "de": "80 %",
            "es": "80 %"
          }
        },
        {
          "value": "90",
          "label": {
            "en": "90 %",
            "fr": "90 %",
            "de": "90 %",
            "es": "90 %"
          }
        },
        {
          "value": "95",
          "label": {
            "en": "95 %",
            "fr": "95 %",
            "de": "95 %",
            "es": "95 %"
          }
        }
      ],
      "default": "90"
    },
    {
      "key": "language",
      "type": "select",
      "label": {
        "en": "Language of the names",
        "fr": "Langue des noms",
        "de": "Sprache der Namen",
        "es": "Idioma de los nombres"
      },
      "description": {
        "en": "Feature names and texts sent by the integration.",
        "fr": "Noms des fonctionnalités et textes envoyés par l'intégration.",
        "de": "Namen der Funktionen und Texte der Integration.",
        "es": "Nombres de las funciones y textos enviados por la integración."
      },
      "options": [
        {
          "value": "en",
          "label": {
            "en": "English",
            "fr": "Anglais",
            "de": "Englisch",
            "es": "Inglés"
          }
        },
        {
          "value": "fr",
          "label": {
            "en": "French",
            "fr": "Français",
            "de": "Französisch",
            "es": "Francés"
          }
        },
        {
          "value": "de",
          "label": {
            "en": "German",
            "fr": "Allemand",
            "de": "Deutsch",
            "es": "Alemán"
          }
        },
        {
          "value": "es",
          "label": {
            "en": "Spanish",
            "fr": "Espagnol",
            "de": "Spanisch",
            "es": "Español"
          }
        }
      ],
      "default": "fr"
    }
  ],
  "actions": [
    {
      "key": "test_connection",
      "label": {
        "en": "Test the connection",
        "fr": "Tester la connexion",
        "de": "Verbindung testen",
        "es": "Probar la conexión"
      },
      "timeout_seconds": 30
    }
  ],
  "scene_triggers": [
    {
      "key": "file_uploaded",
      "label": {
        "en": "A file is uploaded",
        "fr": "Un fichier est déposé",
        "de": "Eine Datei wird hochgeladen",
        "es": "Se sube un archivo"
      },
      "description": {
        "en": "A user uploads a file to SFTPGo (SFTP, FTP, WebDAV or web), for any user, added to Gladys or not.",
        "fr": "Un utilisateur dépose un fichier sur SFTPGo (SFTP, FTP, WebDAV ou web), ajouté à Gladys ou non.",
        "de": "Ein Benutzer lädt eine Datei auf SFTPGo hoch (SFTP, FTP, WebDAV oder Web), in Gladys angelegt oder nicht.",
        "es": "Un usuario sube un archivo a SFTPGo (SFTP, FTP, WebDAV o web), añadido a Gladys o no."
      },
      "fields": [
        {
          "key": "device",
          "type": "multi_select",
          "source": "devices",
          "label": {
            "en": "Users (empty: any)",
            "fr": "Utilisateurs (vide : tous)",
            "de": "Benutzer (leer: alle)",
            "es": "Usuarios (vacío: todos)"
          }
        },
        {
          "key": "folder",
          "type": "string",
          "label": {
            "en": "Folder (empty: any)",
            "fr": "Dossier (vide : tous)",
            "de": "Ordner (leer: alle)",
            "es": "Carpeta (vacío: todas)"
          },
          "description": {
            "en": "Exactly the folder of the file, e.g. /scans",
            "fr": "Exactement le dossier du fichier, ex. /scans",
            "de": "Genau der Ordner der Datei, z. B. /scans",
            "es": "Exactamente la carpeta del archivo, p. ej. /scans"
          }
        },
        {
          "key": "extension",
          "type": "string",
          "label": {
            "en": "Extension (empty: any)",
            "fr": "Extension (vide : toutes)",
            "de": "Endung (leer: alle)",
            "es": "Extensión (vacío: todas)"
          },
          "description": {
            "en": "Lowercase, without dot, e.g. pdf",
            "fr": "En minuscules, sans point, ex. pdf",
            "de": "Kleingeschrieben, ohne Punkt, z. B. pdf",
            "es": "En minúsculas, sin punto, p. ej. pdf"
          }
        }
      ],
      "variables": [
        {
          "key": "user",
          "type": "string",
          "label": {
            "en": "User",
            "fr": "Utilisateur",
            "de": "Benutzer",
            "es": "Usuario"
          }
        },
        {
          "key": "path",
          "type": "string",
          "label": {
            "en": "Path",
            "fr": "Chemin",
            "de": "Pfad",
            "es": "Ruta"
          }
        },
        {
          "key": "folder",
          "type": "string",
          "label": {
            "en": "Folder",
            "fr": "Dossier",
            "de": "Ordner",
            "es": "Carpeta"
          }
        },
        {
          "key": "file_name",
          "type": "string",
          "label": {
            "en": "File name",
            "fr": "Nom du fichier",
            "de": "Dateiname",
            "es": "Nombre del archivo"
          }
        },
        {
          "key": "extension",
          "type": "string",
          "label": {
            "en": "Extension",
            "fr": "Extension",
            "de": "Endung",
            "es": "Extensión"
          }
        },
        {
          "key": "size",
          "type": "string",
          "label": {
            "en": "Size",
            "fr": "Taille",
            "de": "Größe",
            "es": "Tamaño"
          }
        },
        {
          "key": "size_bytes",
          "type": "number",
          "label": {
            "en": "Size (bytes)",
            "fr": "Taille (octets)",
            "de": "Größe (Bytes)",
            "es": "Tamaño (bytes)"
          }
        },
        {
          "key": "protocol",
          "type": "string",
          "label": {
            "en": "Protocol",
            "fr": "Protocole",
            "de": "Protokoll",
            "es": "Protocolo"
          }
        },
        {
          "key": "ip",
          "type": "string",
          "label": {
            "en": "Client address",
            "fr": "Adresse du client",
            "de": "Client-Adresse",
            "es": "Dirección del cliente"
          }
        }
      ]
    },
    {
      "key": "quota_threshold_reached",
      "label": {
        "en": "A quota goes above the threshold",
        "fr": "Un quota dépasse le seuil",
        "de": "Ein Kontingent überschreitet die Schwelle",
        "es": "Una cuota supera el umbral"
      },
      "description": {
        "en": "A user goes above the quota threshold of the configuration (size or files). Once, until the usage goes back down.",
        "fr": "Un utilisateur dépasse le seuil de quota de la configuration (taille ou fichiers). Une fois, jusqu'à ce que l'usage redescende.",
        "de": "Ein Benutzer überschreitet die Kontingentschwelle der Konfiguration (Größe oder Dateien). Einmal, bis die Nutzung wieder sinkt.",
        "es": "Un usuario supera el umbral de cuota de la configuración (tamaño o archivos). Una vez, hasta que el uso vuelva a bajar."
      },
      "fields": [
        {
          "key": "device",
          "type": "multi_select",
          "source": "devices",
          "label": {
            "en": "Users (empty: any)",
            "fr": "Utilisateurs (vide : tous)",
            "de": "Benutzer (leer: alle)",
            "es": "Usuarios (vacío: todos)"
          }
        }
      ],
      "variables": [
        {
          "key": "user",
          "type": "string",
          "label": {
            "en": "User",
            "fr": "Utilisateur",
            "de": "Benutzer",
            "es": "Usuario"
          }
        },
        {
          "key": "percent",
          "type": "number",
          "label": {
            "en": "Quota used (%)",
            "fr": "Quota utilisé (%)",
            "de": "Belegtes Kontingent (%)",
            "es": "Cuota usada (%)"
          }
        },
        {
          "key": "threshold",
          "type": "number",
          "label": {
            "en": "Threshold (%)",
            "fr": "Seuil (%)",
            "de": "Schwelle (%)",
            "es": "Umbral (%)"
          }
        },
        {
          "key": "used_size",
          "type": "string",
          "label": {
            "en": "Space used",
            "fr": "Espace utilisé",
            "de": "Belegter Speicher",
            "es": "Espacio usado"
          }
        },
        {
          "key": "quota_size",
          "type": "string",
          "label": {
            "en": "Size quota",
            "fr": "Quota de taille",
            "de": "Größenkontingent",
            "es": "Cuota de tamaño"
          }
        }
      ]
    },
    {
      "key": "login_failed",
      "label": {
        "en": "A login is refused",
        "fr": "Une connexion est refusée",
        "de": "Eine Anmeldung wird abgelehnt",
        "es": "Se rechaza un inicio de sesión"
      },
      "description": {
        "en": "Wrong password or unknown user, on any protocol. One event per user and address at each reading.",
        "fr": "Mauvais mot de passe ou utilisateur inconnu, sur tout protocole. Un événement par utilisateur et adresse à chaque lecture.",
        "de": "Falsches Passwort oder unbekannter Benutzer, auf jedem Protokoll. Ein Ereignis pro Benutzer und Adresse bei jedem Lesen.",
        "es": "Contraseña incorrecta o usuario desconocido, en cualquier protocolo. Un evento por usuario y dirección en cada lectura."
      },
      "fields": [
        {
          "key": "user",
          "type": "string",
          "label": {
            "en": "Username (empty: any)",
            "fr": "Identifiant (vide : tous)",
            "de": "Benutzername (leer: alle)",
            "es": "Usuario (vacío: todos)"
          }
        }
      ],
      "variables": [
        {
          "key": "user",
          "type": "string",
          "label": {
            "en": "Username tried",
            "fr": "Identifiant essayé",
            "de": "Versuchter Benutzername",
            "es": "Usuario probado"
          }
        },
        {
          "key": "ip",
          "type": "string",
          "label": {
            "en": "Client address",
            "fr": "Adresse du client",
            "de": "Client-Adresse",
            "es": "Dirección del cliente"
          }
        },
        {
          "key": "protocol",
          "type": "string",
          "label": {
            "en": "Protocol",
            "fr": "Protocole",
            "de": "Protokoll",
            "es": "Protocolo"
          }
        },
        {
          "key": "attempts",
          "type": "number",
          "label": {
            "en": "Attempts",
            "fr": "Tentatives",
            "de": "Versuche",
            "es": "Intentos"
          }
        },
        {
          "key": "reason",
          "type": "string",
          "label": {
            "en": "Reason",
            "fr": "Raison",
            "de": "Grund",
            "es": "Motivo"
          }
        },
        {
          "key": "unknown_user",
          "type": "boolean",
          "label": {
            "en": "Unknown user",
            "fr": "Utilisateur inconnu",
            "de": "Unbekannter Benutzer",
            "es": "Usuario desconocido"
          }
        }
      ]
    }
  ],
  "scene_actions": [
    {
      "key": "get_user_status",
      "label": {
        "en": "State of a user",
        "fr": "État d'un utilisateur",
        "de": "Zustand eines Benutzers",
        "es": "Estado de un usuario"
      },
      "description": {
        "en": "Reads the quota, the connections and the last file uploaded of an SFTPGo user, and a ready-made sentence.",
        "fr": "Lit le quota, les connexions et le dernier fichier déposé d'un utilisateur SFTPGo, et une phrase toute prête.",
        "de": "Liest Kontingent, Verbindungen und die zuletzt hochgeladene Datei eines SFTPGo-Benutzers, und einen fertigen Satz.",
        "es": "Lee la cuota, las conexiones y el último archivo subido de un usuario de SFTPGo, y una frase lista."
      },
      "timeout_seconds": 30,
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "User",
            "fr": "Utilisateur",
            "de": "Benutzer",
            "es": "Usuario"
          },
          "required": true
        }
      ],
      "outputs": [
        {
          "key": "user",
          "type": "string",
          "label": {
            "en": "User",
            "fr": "Utilisateur",
            "de": "Benutzer",
            "es": "Usuario"
          }
        },
        {
          "key": "quota_percent",
          "type": "number",
          "label": {
            "en": "Quota used (%, -1 without quota)",
            "fr": "Quota utilisé (%, -1 sans quota)",
            "de": "Belegtes Kontingent (%, -1 ohne)",
            "es": "Cuota usada (%, -1 sin cuota)"
          }
        },
        {
          "key": "used_size",
          "type": "string",
          "label": {
            "en": "Space used",
            "fr": "Espace utilisé",
            "de": "Belegter Speicher",
            "es": "Espacio usado"
          }
        },
        {
          "key": "files",
          "type": "number",
          "label": {
            "en": "Files",
            "fr": "Fichiers",
            "de": "Dateien",
            "es": "Archivos"
          }
        },
        {
          "key": "connections",
          "type": "number",
          "label": {
            "en": "Connections",
            "fr": "Connexions",
            "de": "Verbindungen",
            "es": "Conexiones"
          }
        },
        {
          "key": "uploads_today",
          "type": "number",
          "label": {
            "en": "Files uploaded today",
            "fr": "Fichiers déposés aujourd'hui",
            "de": "Heute hochgeladene Dateien",
            "es": "Archivos subidos hoy"
          }
